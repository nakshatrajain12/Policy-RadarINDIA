# ==============================================================================
# Policy Radar India - Environment Configuration
# ==============================================================================

# 1. FastAPI Backend API Base URL
# Default local development: http://localhost:8000
# If unset or unreachable, the frontend automatically falls back to bundled verified data (offline mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Supabase Project URL (Optional)
# Used for real-time scheme syncing and authenticated user persistence.
# Example: https://yourproject.supabase.co
# Do NOT use placeholder values; leave empty if running in guest/offline mode.
NEXT_PUBLIC_SUPABASE_URL=

# 3. Supabase Anonymous Public API Key (Optional)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
